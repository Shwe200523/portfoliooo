html {
    scroll-behavior: smooth;
}

body {
    background: #F6F1E8;
    color: #2C3441;
    font-family: "Shippori Mincho", "Noto Serif JP", serif;
    font-weight: 400;
    line-height: 1.9;
    letter-spacing: 0.04em;
    overflow-x: hidden;
}

body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.03;
}

img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

::selection {
    background: #DCB4AA;
    color: #fff;
}

a {
    color: inherit;
    text-decoration: none;
}

#ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 380px;
    height: auto;
    object-fit: contain;
    z-index: 4;
    pointer-events: none;
    will-change: transform;
    display: none;
    filter: drop-shadow(0 30px 50px rgba(44, 52, 65, 0.16));
}

[data-ring-slot] {
    position: relative;
}

[data-ring-slot]::after {
        content: "";
        position: absolute;
        inset: 0;
        background: url("../img/gray.svg") center / contain no-repeat;
}

body.ring_on [data-ring-slot]::after {
    display: none;
}

.eyebrow {
    font-family: "Jost", "Shippori Mincho", sans-serif;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #6C7178;
    margin-bottom: 1.8rem;
}

.eyebrow_gold {
    color: #C3A878;
}

.eyebrow_center {
    text-align: center;
}

.accent_line {
    display: block;
    width: 80px;
    height: 1px;
    background: #C3A878;
    opacity: 0.7;
}

.section_title {
    font-family: "Shippori Mincho", "Noto Serif JP", serif;
    font-weight: 500;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: 0.16em;
    text-align: center;
}

.section_title_left {
    text-align: left;
}

.textlink {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: "Jost", "Shippori Mincho", sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: #6C7178;
    transition: color 0.55s ease;

    span {
        transition: transform 0.55s cubic-bezier(0.19, 1, 0.22, 1);
    }
}

.textlink:hover {
        color: #B0935F;

        span {
            transform: translateX(7px);
        }
}

.textlink_gold {
    color: #B0935F;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: "Shippori Mincho", "Noto Serif JP", serif;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    color: #fff;
    background: #2C3441;
    padding: 1.15em 3em;
    border-radius: 999px;
    transition: background 0.55s ease, transform 0.55s cubic-bezier(0.19, 1, 0.22, 1), box-shadow 0.55s ease;

    span {
        transition: transform 0.55s cubic-bezier(0.19, 1, 0.22, 1);
    }
}

.btn:hover {
        background: #B0935F;
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(176, 147, 95, 0.32);

        span {
            transform: translateX(6px);
        }
}

.btn_ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
}

.btn_ghost:hover {
        background: #fff;
        color: #2C3441;
        border-color: #fff;
}

.dot {
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    margin: 0 0.9rem;
    vertical-align: middle;
    opacity: 0.6;
}

.nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.7rem clamp(1.5rem, 5.5vw, 5rem);
    transition: background 0.5s ease, padding 0.5s ease, box-shadow 0.5s ease;

    .nav_logo {
        display: flex;
        align-items: center;
        line-height: 0;

        a {
            display: inline-flex;
        }

        img {
            display: block;
            width: auto;
            height: clamp(3rem, 5vw, 3.75rem);
            transition: height 0.5s ease, filter 0.5s ease;
        }
    }

    .nav_toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: #2C3441;
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.72rem;
        font-weight: 400;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        cursor: pointer;
    }

    .nav_toggle_bars {
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
        width: 26px;

        span {
            display: block;
            height: 1px;
            width: 100%;
            background: currentColor;
            transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
        }
    }

    .nav_toggle:hover .nav_toggle_bars span:first-child {
        transform: translateX(4px);
    }
}

.nav.is_scrolled {
        background: rgba(246, 241, 232, 0.584);
        backdrop-filter: blur(10px);
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
        box-shadow: 0 1px 0 rgba(44, 52, 65, 0.12);
}

.nav.is_on_dark {
        background: transparent;
        box-shadow: none;
        backdrop-filter: none;

        .nav_logo img {
            filter: drop-shadow(0 1px 6px rgba(0, 0, 0, 0.55));
        }

        .nav_toggle {
            color: #fff;
        }

        .nav_toggle_bars span {
            background: #fff;
        }
}

.nav.is_scrolled .nav_logo img {
        height: clamp(2.5rem, 4.2vw, 3.125rem);
}
/* !cmt Nav overlay menu */

body.menu_open {
    overflow: hidden;
}

.menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    background: #FBF8F2;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s ease, visibility 0.45s ease;
}

.menu.is_open {
        opacity: 1;
        visibility: visible;
}

.menu_bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.7rem clamp(1.5rem, 5.5vw, 5rem);
    border-bottom: 1px solid rgba(44, 52, 65, 0.1);
    background: #FBF8F2;
}

.menu_logo {
    display: inline-flex;
    line-height: 0;

    img {
        display: block;
        width: auto;
        height: clamp(3rem, 5vw, 3.75rem);
    }
}

.menu_close {
    position: relative;
    width: 34px;
    height: 34px;
    cursor: pointer;
    color: #2C3441;

    span {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 26px;
        height: 1px;
        background: currentColor;
        transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .menu_close span:first-child {
            transform: translate(-50%, -50%) rotate(45deg);
    }

    .menu_close span:last-child {
            transform: translate(-50%, -50%) rotate(-45deg);
    }
}

.menu_close:hover span:first-child {
        transform: translate(-50%, -50%) rotate(135deg);
}

.menu_close:hover span:last-child {
        transform: translate(-50%, -50%) rotate(45deg);
}

.menu_inner {
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(1.2rem, 2.5vw, 2rem) clamp(1.5rem, 5.5vw, 5rem) clamp(1.4rem, 3vw, 2.4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1rem, 2.2vh, 2rem);
   
    overflow-y: auto;
    
}

.menu_eyebrow {
    margin-bottom: 0;
}

.menu_feature {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.2rem, 2.5vw, 2.2rem);
    margin-bottom: 0;
}

.menu_card {
    display: flex;
    flex-direction: column;

    .menu_card_img {
        display: block;
        aspect-ratio: 4 / 3;
        max-height: clamp(150px, 26vh, 300px);
        border-radius: 4px;
        background: #F1EBE0;
        overflow: hidden;
        margin-bottom: 0.9rem;

        img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background-size: cover;
            transition: transform 0.7s cubic-bezier(0.19, 1, 0.22, 1);
        }
    }

    .menu_card_row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .menu_card_name {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-size: clamp(1.1rem, 1.8vw, 1.35rem);
        font-weight: 500;
        letter-spacing: 0.1em;
        color: #2C3441;
    }

    .menu_card_arrow {
        color: #C3A878;
        transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
    }
}

.menu_card:hover .menu_card_img img {
        transform: scale(1.05);
}

.menu_card:hover .menu_card_arrow {
        transform: translateX(6px);
}

.menu_links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid rgba(44, 52, 65, 0.12);

    a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: clamp(0.7rem, 1.4vh, 1.1rem) 0;
        border-bottom: 1px solid rgba(44, 52, 65, 0.12);
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-size: 1rem;
        letter-spacing: 0.08em;
        color: #2C3441;
        transition: color 0.35s ease;

        span:last-child {
            color: #C3A878;
            transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
        }
    }

    .menu_links a:hover {
            color: #C3A878;
    }

    .menu_links a:hover span:last-child {
            transform: translateX(6px);
    }
}

.menu_foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.2rem, 2.5vw, 2rem);
    align-items: stretch;
}

.menu_tel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.4rem clamp(1.3rem, 2.5vw, 2rem);
    background: #F1EBE0;
    border-radius: 4px;

    .menu_tel_label {
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #6C7178;
    }

    .menu_tel_num {
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-size: 1.45rem;
        letter-spacing: 0.06em;
        color: #2C3441;
    }
}

.menu_cta {
    justify-content: center;
    background: #C9A7A0;
    border-color: #C9A7A0;
}

.menu_cta:hover {
        background: #b8938b;
        border-color: #b8938b;
}

.hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    overflow: hidden;
    background-image: url(../img/hero.png);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: right 30%;

    .hero_vertical {
        position: absolute;
        left: clamp(1rem, 2.2vw, 2.1rem);
        top: 50%;
        transform: translateY(-50%);
        writing-mode: vertical-rl;
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-style: italic;
        font-size: 0.85rem;
        letter-spacing: 0.35em;
        color: #9A9DA2;
    }

    .hero_copy {
        padding-left: clamp(3.5rem, 8vw, 8rem);
        padding-right: 2rem;
        z-index: 5;
    }

    .hero_title {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(2.3rem, 4.6vw, 4rem);
        line-height: 1.5;
        letter-spacing: 0.06em;
        margin-bottom: clamp(3rem, 7vh, 5rem);
    }

    .hero_lede {
        color: #8C8882;
        font-size: 0.94rem;
        line-height: 2.3;
        letter-spacing: 0.06em;
        margin-bottom: clamp(2.6rem, 5vh, 4.2rem);
    }

    .hero_stage {
        height: 88vh;
        margin-right: -8%;
    }

    
    .hero_scroll {
        position: absolute;
        left: 50%;
        bottom: 2.4rem;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.55rem;
    }

    .hero_scroll_text {
        writing-mode: vertical-rl;
        text-orientation: upright;
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #8A6D3B;
    }

    .hero_scroll_line {
        width: 1px;
        height: 26px;
        background: #C3A878;
    }

    .hero_scroll_arrow {
        width: 10px;
        height: 10px;
        margin-top: -3px;
        border-right: 1.8px solid #C3A878;
        border-bottom: 1.8px solid #C3A878;
        transform: rotate(45deg);
        animation: scrollArrow 1.5s ease-in-out infinite;
    }
}

.hero::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 22vh;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(251, 248, 242, 0) 0%, #FBF8F2 100%);
}
@keyframes scrollArrow {

    0%, 100% {
        transform: rotate(45deg) translate(0, 0);
        opacity: 0.45;
    }

    50% {
        transform: rotate(45deg) translate(4px, 4px);
        opacity: 1;
    }
}

.concept {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding: clamp(4rem, 9vh, 8rem) clamp(1.5rem, 5.5vw, 5rem);
    min-height: 70vh;
    background-repeat: no-repeat;
    background-size: cover;
    background-image: url(../img/concept.png);

    .concept_stage,
    .concept_copy {
        position: relative;
        z-index: 2;
    }

    .concept_stage {
        height: 52vh;
        transform: translate(5%, 10%);
    }

    .concept_copy {
        text-align: right;

        .accent_line {
            margin-left: auto;
        }
    }

    .concept_title {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(1.8rem, 3.4vw, 3rem);
        line-height: 1.7;
        letter-spacing: 0.1em;
        margin-bottom: 2.4rem;
    }

    .concept_body {
        color: #6C7178;
        font-size: 0.88rem;
        line-height: 2.4;
        letter-spacing: 0.08em;
        margin-bottom: 2rem;
    }
}

.concept::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 22vh;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(to bottom, #FBF8F2 0%, rgba(251, 248, 242, 0) 100%);
}

.concept::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 22vh;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(to top, #FBF8F2 0%, rgba(251, 248, 242, 0) 100%);
}

.detail {
    position: relative;
    padding: clamp(4rem, 8vh, 7rem) clamp(1.5rem, 5.5vw, 5rem);
    background: #FBF8F2;
    overflow: hidden;
    min-height: 90vh;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 1fr auto;
    align-items: center;
    gap: 1rem;

    .detail_copy {
        grid-column: 1;
        align-self: center;
        z-index: 5;
        padding: 2rem 2.2rem;
        background: rgba(251, 248, 242, 0.72);
        backdrop-filter: blur(6px);
        border-radius: 4px;
    }

    .detail_stage {
        grid-column: 2;
        grid-row: 1;
        height: 46vh;
        position: relative;
        z-index: 2;
    }

    .detail_spec {
        grid-column: 3;
        align-self: center;
        justify-self: end;
        z-index: 5;
        padding: 2rem 2.2rem;
        background: rgba(251, 248, 242, 0.72);
        backdrop-filter: blur(6px);
        border-radius: 4px;

        .detail_spec_label {
            font-family: "Jost", "Shippori Mincho", sans-serif;
            font-size: 0.68rem;
            letter-spacing: 0.24em;
            color: #C3A878;
            margin-bottom: 1.4rem;
        }

        > div {
            display: grid;
            grid-template-columns: 3.5rem 1fr;
            gap: 0.8rem;
            padding: 0.5rem 0;
            font-size: 0.82rem;
        }

        .detail_spec_key {
            color: #6C7178;
        }
    }

    .detail_foot {
        grid-column: 1 / -1;
        grid-row: 2;
        text-align: center;
        margin-top: 1rem;
        position: relative;
        z-index: 2;
        justify-self: center;
        max-width: 42rem;
        padding: 1.6rem 3rem;
        background: rgba(251, 248, 242, 0.72);
        backdrop-filter: blur(6px);
        border-radius: 4px;
    }

    .detail_lead {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(1.4rem, 2.4vw, 2rem);
        line-height: 1.7;
        letter-spacing: 0.08em;
        margin-bottom: 1.8rem;
    }

    .detail_body {
        color: #6C7178;
        font-size: 0.82rem;
        line-height: 2.3;
        letter-spacing: 0.06em;
    }

    .detail_name {
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-weight: 500;
        font-size: clamp(1.8rem, 3.2vw, 2.8rem);
        letter-spacing: 0.14em;
        margin-bottom: 1rem;

        .detail_name_jp {
            font-family: "Shippori Mincho", "Noto Serif JP", serif;
            font-style: normal;
            font-size: 0.55em;
            letter-spacing: 0.3em;
        }
    }

    .detail_meta {
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        color: #6C7178;
        margin-bottom: 1.2rem;
    }

    .detail_price {
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-size: clamp(1.5rem, 3vw, 1.9rem);
        letter-spacing: 0.08em;
    }
}

.detail::before {
        content: "";
        position: absolute;
        inset: -30px;
        z-index: 0;
        background: url(../img/detail.png) center / cover no-repeat;
        filter: blur(7px);
        transform: scale(1.05);
        -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
        mask-image: linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
}

.only_one {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: 80vh;

    .only_one_panel {
        position: relative;
        background-image: url(../img/onlyone.png);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
    }

    .only_one_stage {
        position: absolute;
        inset: 8% 10%;
        width: 17vw;
        transform: translate(60%,10%);
    }

    .only_one_copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 clamp(3rem, 7vw, 7rem);
    }

    .only_one_title {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(1.9rem, 3.2vw, 2.9rem);
        line-height: 1.7;
        letter-spacing: 0.1em;
        margin-bottom: 2rem;
    }

    .only_one_body {
        color: #6C7178;
        font-size: 0.85rem;
        line-height: 2.4;
        letter-spacing: 0.06em;
    }
}

.product_list {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(4rem, 9vh, 8rem) clamp(1.5rem, 5.5vw, 5rem);

    .product_list_title {
        margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
    }

    .product_list_showcase {
        display: grid;
        grid-template-columns: 1.55fr 1fr;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: stretch;
    }

    .product_list_hero {
        position: relative;
        background-image: url(../img/kiji.png);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        aspect-ratio: 780 / 600;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product_list_box {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 74%;
        height: auto;
        transform: translate(-50%, -46%);
        object-fit: contain;
        pointer-events: none;
        z-index: 1;
        filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.35));
    }

    .product_list_stage {
        position: relative;
        width: 52%;
        height: 52%;
        transform: translate(14%, 8%);
        z-index: 2;
    }

    .product_list_ring_mb {
        display: none;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product_list_label {
        position: absolute;
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: #2C3441;
        background: rgba(246, 241, 232, 0.92);
        padding: 0.5em 1.1em;
        border-radius: 999px;
        white-space: nowrap;
    }

    .product_list_label_price {
        top: 20%;
        left: 8%;
    }

    .product_list_label_maten {
        top: 16%;
        right: 8%;
    }

    .product_list_label_mat {
        bottom: 10%;
        left: 13%;
    }

    .product_list_aside {
        display: flex;
        flex-direction: column;
        justify-content: center;

        .textlink {
            align-self: flex-end;
        }
    }

    .product_list_heading {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(1.6rem, 2.6vw, 2.3rem);
        line-height: 1.6;
        letter-spacing: 0.08em;
        margin-bottom: 2.4rem;
    }

    .product_list_thumbs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
        margin-bottom: 2rem;
    }

    .product_card {
        display: block;
        width: 100%;
        text-align: left;
        background: none;
        border: 0;
        padding: 0;
        cursor: pointer;
        font: inherit;
        color: inherit;

        .product_card_img {
            display: block;
            background: #EFE8DB;
            aspect-ratio: 1;
            margin-bottom: 0.9rem;

            img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                padding: 12%;
                transition: transform 0.9s cubic-bezier(0.19, 1, 0.22, 1);
            }
        }

        .product_card_mat {
            display: block;
            font-family: "Jost", "Shippori Mincho", sans-serif;
            font-size: 0.72rem;
            letter-spacing: 0.06em;
            color: #6C7178;
            white-space: nowrap;
        }

        .product_card_price {
            display: block;
            font-size: 0.92rem;
            margin-top: 0.2rem;
        }
    }

    .product_list .product_card:hover .product_card_img img {
            transform: scale(1.06);
    }
}

.collection {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(4rem, 9vh, 8rem) clamp(1.5rem, 5.5vw, 5rem);

    .section_title {
        margin-bottom: clamp(2.5rem, 6vh, 5rem);
    }

    .collection_list {
        border-top: 1px solid rgba(44, 52, 65, 0.12);
    }

    .collection_row {
        display: grid;
        grid-template-columns: minmax(11rem, 1.4fr) 6rem 2.2fr auto;
        align-items: center;
        gap: 2rem;
        padding: clamp(2rem, 4vh, 3.2rem) 0.5rem;
        border-bottom: 1px solid rgba(44, 52, 65, 0.12);
        transition: padding 0.55s cubic-bezier(0.19, 1, 0.22, 1);

        .collection_row_name {
            font-family: "Cormorant Garamond", "Shippori Mincho", serif;
            font-size: clamp(1.4rem, 2.2vw, 1.9rem);
            letter-spacing: 0.1em;
        }

        .collection_row_jp {
            font-size: 0.9rem;
            letter-spacing: 0.24em;
            color: #6C7178;
        }

        .collection_row_desc {
            font-size: 0.85rem;
            color: #6C7178;
            letter-spacing: 0.04em;
        }

        .collection_row_arrow {
            font-family: "Jost", "Shippori Mincho", sans-serif;
            color: #B0935F;
            transition: transform 0.55s cubic-bezier(0.19, 1, 0.22, 1);
        }
    }

    .collection .collection_row:hover {
            padding-left: 1.6rem;
            padding-right: 1.2rem;

            .collection_row_arrow {
                transform: translateX(10px);
            }
    }
}

.craft {
    position: relative;
    height: 100vh;
    height: 100dvh;
    background: #14161B;
    color: #fff;
    overflow: hidden;

    .craft_stage {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .craft_bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0;
        transform: scale(1.04);
        transition: opacity 1.1s ease, transform 1.1s ease;
        will-change: opacity, transform;
    }

    .craft_bg.is_active {
            opacity: 1;
            transform: scale(1);
            transition: opacity 1.1s ease, transform 1.6s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .craft_bg_1 {
        background-image: url("../img/yaki.png");
    }

    .craft_bg_2 {
        background-image: url("../img/poolish.png");
    }

    .craft_bg_3 {
        background-image: url("../img/set.png");
    }

    .craft_bg_4 {
        background-image: url("../img/deki.png");
    }

    .craft_bg_5 {
        background-image: url("../img/Gemini_Generated_Image_4khq5z4khq5z4khq.png");
    }

    .craft_scrim {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, rgba(8, 9, 12, 0.82) 0%, rgba(8, 9, 12, 0.3) 38%, rgba(8, 9, 12, 0.1) 62%, rgba(8, 9, 12, 0.2) 100%),
            linear-gradient(180deg, rgba(8, 9, 12, 0.5) 0%, transparent 26%, transparent 62%, rgba(8, 9, 12, 0.55) 100%);
    }

    .craft_lockup {
        position: absolute;
        top: clamp(3.5rem, 8vh, 6rem);
        left: clamp(1.5rem, 5.5vw, 5rem);
        z-index: 3;
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
    }

    .craft_brand {
        writing-mode: vertical-rl;
        text-orientation: upright;
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-weight: 400;
        font-size: clamp(2.6rem, 4.6vw, 4.2rem);
        line-height: 1;
        letter-spacing: -0.1em;
    }

    .craft_brand_jp {
        writing-mode: vertical-rl;
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-size: 0.92rem;
        letter-spacing: 0.42em;
        color: rgba(255, 255, 255, 0.82);
        margin-top: 10rem;
    }

    .craft_rail {
        position: absolute;
        left: clamp(1.5rem, 5.5vw, 5rem);
        bottom: clamp(2rem, 6vh, 4rem);
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .craft_thumb {
        width: 92px;
        height: 58px;
        background-size: cover;
        background-position: center;
        cursor: pointer;
        position: relative;
        filter: grayscale(0.4) brightness(0.62);
        opacity: 0.6;
        transition: opacity 0.5s ease, filter 0.5s ease;
    }

    .craft_thumb::after {
            content: "";
            position: absolute;
            inset: -4px;
            border: 1px solid #fff;
            opacity: 0;
            transition: opacity 0.5s ease;
    }

    .craft_thumb:hover {
            opacity: 0.9;
            filter: grayscale(0) brightness(0.9);
    }

    .craft_thumb.is_active {
            opacity: 1;
            filter: grayscale(0) brightness(1);
    }

    .craft_thumb.is_active::after {
                opacity: 1;
    }

    .craft_thumb:focus-visible {
            outline: 2px solid #C3A878;
            outline-offset: 3px;
    }

    .craft_thumb_1 {
        background-image: url("../img/yaki.png");
    }

    .craft_thumb_2 {
        background-image: url("../img/poolish.png");
    }

    .craft_thumb_3 {
        background-image: url("../img/set.png");
    }

    .craft_thumb_4 {
        background-image: url("../img/deki.png");
    }

    .craft_thumb_5 {
        background-image: url("../img/Gemini_Generated_Image_4khq5z4khq5z4khq.png");
    }

    .craft_panels {
        position: absolute;
        right: clamp(1.5rem, 5.5vw, 5rem);
        top: 50%;
        transform: translateY(-50%);
        z-index: 3;
        width: min(30rem, 42vw);
        text-align: right;
    }

    .craft_panel {
        position: absolute;
        top: 50%;
        right: 0;
        transform: translateY(-50%);
        width: 100%;
        pointer-events: none;
    }

    .craft_figure {
        display: none;
    }

    .craft_index {
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.88rem;
        letter-spacing: 0.22em;
        color: rgba(255, 255, 255, 0.92);
        margin-bottom: 1.8rem;

        span {
            display: inline-block;
            padding-bottom: 7px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.65);
        }
    }

    .craft_step {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(2.4rem, 4.4vw, 3.8rem);
        letter-spacing: 0.14em;
        line-height: 1.2;
    }

    .craft_note {
        margin-left: auto;
        margin-top: 1.2rem;
        max-width: 42ch;
        border: 1px solid rgba(255, 255, 255, 0.35);
        background: rgba(10, 12, 16, 0.28);
        backdrop-filter: blur(3px);
        padding: 2rem 2.2rem;

        p {
            font-size: 0.92rem;
            line-height: 2.2;
            letter-spacing: 0.04em;
            color: rgba(255, 255, 255, 0.92);
            text-align: left;
        }
    }

    .craft_progress {
        position: absolute;
        left: clamp(1.5rem, 5.5vw, 5rem);
        right: clamp(1.5rem, 5.5vw, 5rem);
        bottom: 0;
        height: 2px;
        background: rgba(255, 255, 255, 0.14);
        z-index: 3;

        span {
            display: block;
            height: 100%;
            width: 0%;
            background: #C3A878;
        }
    }
}

.craft::before,
    .craft::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 16vh;
        z-index: 1;
        pointer-events: none;
}

.craft::before {
        top: 0;
        background: linear-gradient(to bottom, #14161B 0%, rgba(20, 22, 27, 0) 100%);
}

.craft::after {
        bottom: 0;
        background: linear-gradient(to top, #14161B 0%, rgba(20, 22, 27, 0) 100%);
}

.whyus {
    position: relative;
    background:
        linear-gradient(180deg, rgba(241, 234, 220, 0.9) 0%, rgba(246, 241, 232, 0.94) 60%),
        url("../img/kiji.png") center / cover no-repeat;
    padding: clamp(4rem, 10vh, 8.5rem) clamp(1.5rem, 5.5vw, 5rem);

    .whyus_inner {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(2.5rem, 5vw, 5rem);
        align-items: center;
    }

    .whyus_visual {
        position: relative;
        aspect-ratio: 4 / 5;
        overflow: hidden;

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.02);
            transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1);
        }
    }

    .whyus_visual::after {
            content: "";
            position: absolute;
            inset: 14px;
            border: 1px solid rgba(255, 255, 255, 0.55);
            pointer-events: none;
            z-index: 1;
    }

    .whyus_visual:hover img {
            transform: scale(1.1);
    }

    .whyus_visual_cap {
        position: absolute;
        left: 22px;
        bottom: 20px;
        z-index: 1;
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        font-size: 1.15rem;
        letter-spacing: 0.08em;
        color: #6C6152;
    }

    .whyus_content {

        .eyebrow {
            margin-bottom: 0.9rem;
        }

        .section_title {
            margin-bottom: clamp(2rem, 4vh, 3rem);
        }
    }

    .whyus_list {
        display: flex;
        flex-direction: column;
    }

    .whyus_item {
        position: relative;
        display: grid;
        grid-template-columns: 3.6rem 1fr;
        gap: 1.4rem;
        align-items: start;
        padding: clamp(1.4rem, 3vh, 2rem) 0;
        border-top: 1px solid rgba(195, 168, 120, 0.3);
        overflow: hidden;
    }

    .whyus_item:last-of-type {
            border-bottom: 1px solid rgba(195, 168, 120, 0.3);
    }

    .whyus_item::after {
            content: attr(data-ghost);
            position: absolute;
            top: 50%;
            right: -0.1rem;
            transform: translateY(-50%);
            font-family: "Cormorant Garamond", "Shippori Mincho", serif;
            font-size: clamp(4rem, 8vw, 5.5rem);
            line-height: 1;
            color: rgba(195, 168, 120, 0.1);
            pointer-events: none;
    }

    .whyus_num {
        position: relative;
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-size: clamp(1.8rem, 3.5vw, 2.2rem);
        color: #B0935F;
        line-height: 1;
        padding-top: 0.15em;
    }

    .whyus_body {
        position: relative;
    }

    .whyus_heading {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 600;
        font-size: clamp(1.1rem, 2vw, 1.2rem);
        letter-spacing: 0.08em;
        margin-bottom: 0.7rem;
    }

    .whyus_desc {
        color: #6C7178;
        font-size: 0.86rem;
        line-height: 2.05;
        letter-spacing: 0.04em;
    }

    .whyus_cta {
        margin-top: clamp(2rem, 4vh, 3rem);
    }
}

.flow {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(4rem, 9vh, 8rem) clamp(1.5rem, 5.5vw, 5rem);

    .section_title {
        margin-bottom: clamp(2rem, 5vh, 3.5rem);
    }

    .flow_list {
        border-top: 1px solid rgba(44, 52, 65, 0.12);
    }

    .flow_item {
        position: relative;
        display: grid;
        grid-template-columns: 10rem 16rem 1fr;
        align-items: center;
        gap: 2rem;
        padding: clamp(1.6rem, 3.5vh, 2.6rem) clamp(0.5rem, 1.5vw, 1.4rem);
        border-bottom: 1px solid rgba(44, 52, 65, 0.12);
        transition: background 0.5s ease, padding-left 0.5s ease;
    }

    .flow .flow_item::before {
            content: "";
            position: absolute;
            left: 0;
            top: 50%;
            width: 0;
            height: 1px;
            background: #C3A878;
            transform: translateY(-50%);
            transition: width 0.5s ease;
    }

    .flow .flow_item:hover {
            background: rgba(255, 255, 255, 0.4);
            padding-left: clamp(1.4rem, 2.5vw, 2.4rem);

            .flow_step {
                color: #9A7E4B;
            }
    }

    .flow .flow_item:hover::before {
                width: clamp(0.7rem, 1.5vw, 1.4rem);
    }

    .flow_step {
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-style: italic;
        font-size: clamp(1.2rem, 2.4vw, 1.4rem);
        color: #B0935F;
        letter-spacing: 0.04em;
        transition: color 0.5s ease;
    }

    .flow_heading {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 600;
        font-size: clamp(1.05rem, 2vw, 1.15rem);
        letter-spacing: 0.08em;
    }

    .flow_desc {
        color: #6C7178;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
    }
}

.news {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(4rem, 9vh, 8rem) clamp(1.5rem, 5.5vw, 5rem);

    .section_title {
        margin-bottom: clamp(2rem, 5vh, 3.5rem);
    }

    .news_list {
        border-top: 1px solid rgba(44, 52, 65, 0.12);
    }

    .news_row {
        display: grid;
        grid-template-columns: 8rem 4rem 1fr auto;
        align-items: center;
        gap: 1.6rem;
        padding: 1.5rem 0.4rem;
        border-bottom: 1px solid rgba(44, 52, 65, 0.12);
        transition: padding 0.5s cubic-bezier(0.19, 1, 0.22, 1);

        .news_row_date {
            font-family: "Jost", "Shippori Mincho", sans-serif;
            font-size: 0.82rem;
            letter-spacing: 0.08em;
            color: #6C7178;
        }

        .news_row_tag {
            font-family: "Jost", "Shippori Mincho", sans-serif;
            font-size: 0.64rem;
            letter-spacing: 0.14em;
            border: 1px solid #C3A878;
            color: #B0935F;
            padding: 0.25em 0;
            text-align: center;
            border-radius: 2px;
        }

        .news_row_text {
            font-size: 0.92rem;
            letter-spacing: 0.04em;
        }

        .news_row_arrow {
            font-family: "Jost", "Shippori Mincho", sans-serif;
            color: #B0935F;
            transition: transform 0.5s cubic-bezier(0.19, 1, 0.22, 1);
        }
    }

    .news .news_row:hover {
            padding-left: 1.2rem;
            padding-right: 0.8rem;

            .news_row_arrow {
                transform: translateX(8px);
            }
    }
}

.reviews {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(4rem, 9vh, 8rem) clamp(1.5rem, 5.5vw, 5rem);

    .section_title {
        margin-bottom: clamp(2.5rem, 6vh, 4rem);
    }

    .reviews_grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
    }

    .review_card {

        .review_card_photo {
            display: block;
            aspect-ratio: 336 / 180;
            background-size: cover;
            background-position: center;
            background-color: #EFE8DB;
            margin-bottom: 1.6rem;
        }

        .review_card_photo_1 {
            background-image: url("../img/customer_review.jpeg");
        }

        .review_card_photo_2 {
            background-image: url("../img/customer_review1.jpeg");
        }

        .review_card_photo_3 {
            background-image: url("../img/customer_review2.jpeg");
        }

        .review_card_quote {
            font-family: "Cormorant Garamond", "Shippori Mincho", serif;
            font-size: 3rem;
            line-height: 0.2;
            color: #DCB4AA;
            margin: 0.6rem 0 0.4rem;
        }

        .review_card_text {
            font-family: "Shippori Mincho", "Noto Serif JP", serif;
            font-size: clamp(0.95rem, 1.8vw, 1.05rem);
            line-height: 2;
            letter-spacing: 0.04em;
            margin-bottom: 1.6rem;
        }

        .review_card_name {
            font-family: "Jost", "Shippori Mincho", sans-serif;
            font-size: 0.78rem;
            letter-spacing: 0.1em;
            color: #6C7178;
        }
    }
}

.stores {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(4rem, 9vh, 8rem) clamp(1.5rem, 5.5vw, 5rem);

    .section_title {
        margin-bottom: clamp(2.5rem, 6vh, 4rem);
    }

    .stores_grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: clamp(1.5rem, 3vw, 3rem);
    }

    .stores_region {
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.74rem;
        letter-spacing: 0.18em;
        color: #B0935F;
    }

    .stores_rule {
        display: block;
        width: 100%;
        max-width: 240px;
        height: 1px;
        background: rgba(44, 52, 65, 0.12);
        margin: 1.4rem 0;
    }

    .stores_list li {
        font-size: 0.92rem;
        letter-spacing: 0.06em;
        padding: 0.4rem 0;
        color: #6C7178;
    }

    .stores_footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: clamp(2.5rem, 5vh, 4rem);
        padding-top: 2rem;
        border-top: 1px solid rgba(44, 52, 65, 0.12);
    }

    .stores_count {
        font-size: 0.95rem;
        letter-spacing: 0.06em;
    }
}

.contact {
    background: #FBF8F2;
    padding: clamp(4rem, 9vh, 8rem) clamp(1.5rem, 5.5vw, 5rem);

    .contact_head {
        text-align: center;
        max-width: 640px;
        margin: 0 auto clamp(2.5rem, 6vh, 4rem);
    }

    .contact_title {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(1.7rem, 3vw, 2.4rem);
        letter-spacing: 0.16em;
        margin-bottom: 1.6rem;
    }

    .contact_lede {
        color: #6C7178;
        font-size: 0.88rem;
        line-height: 2.2;
        letter-spacing: 0.04em;
    }

    .contact_form {
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.8rem;

        .btn {
            align-self: center;
            margin-top: 1rem;
        }
    }

    .field {
        display: block;

        .field_label {
            display: block;
            font-family: "Jost", "Shippori Mincho", sans-serif;
            font-size: 0.78rem;
            letter-spacing: 0.1em;
            color: #2C3441;
            margin-bottom: 0.7rem;
        }

        input,
        textarea {
            width: 100%;
            font-family: "Shippori Mincho", "Noto Serif JP", serif;
            font-size: 0.95rem;
            color: #2C3441;
            background: #F6F1E8;
            border: 1px solid rgba(44, 52, 65, 0.12);
            padding: 0.9em 1em;
            border-radius: 2px;
            transition: border-color 0.3s ease;
        }

        .contact .field input::placeholder,
            .contact .field textarea::placeholder {
                color: #9A9DA2;
        }

        .contact .field input:focus,
            .contact .field textarea:focus {
                outline: none;
                border-color: #C3A878;
        }

        textarea {
            resize: vertical;
            line-height: 1.9;
        }
    }

    .field_row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.6rem;
    }

    .contact_info {
        display: flex;
        justify-content: center;
        gap: clamp(2rem, 6vw, 5rem);
        flex-wrap: wrap;
        margin-top: clamp(3rem, 6vh, 5rem);
        text-align: center;
    }

    .contact_info_label {
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        color: #B0935F;
        margin-bottom: 0.4rem;
    }

    .contact_info_val {
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-size: 1.2rem;
        letter-spacing: 0.06em;
    }
}

.reservation {
    background: linear-gradient(180deg, #232a35 0%, #2C3441 100%);
    color: #fff;
    text-align: center;
    padding: clamp(5rem, 12vh, 10rem) clamp(1.5rem, 5.5vw, 5rem);

    .reservation_title {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(1.9rem, 3.6vw, 3rem);
        line-height: 1.6;
        letter-spacing: 0.12em;
        margin: 1rem 0 1.4rem;
    }

    .reservation_sub {
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.9rem;
        letter-spacing: 0.06em;
        margin-bottom: 2.8rem;
    }

    .reservation_tel {
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.82rem;
        letter-spacing: 0.08em;
        color: rgba(255, 255, 255, 0.7);
        margin-top: 2rem;

        a {
            border-bottom: 1px solid #C3A878;
            padding-bottom: 2px;
        }
    }
}

.footer {
    background: #14161B;
    color: #fff;
    padding: clamp(4rem, 8vh, 6rem) clamp(1.5rem, 5.5vw, 5rem) 2.5rem;

    .footer_top {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 2.5rem;
        padding-bottom: 3rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    }

    .footer_en {
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-style: italic;
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        color: #DCB4AA;
        margin-bottom: 1rem;
    }

    .footer_h1 {
        font-family: "Shippori Mincho", "Noto Serif JP", serif;
        font-weight: 500;
        font-size: clamp(1.6rem, 3vw, 2.5rem);
        line-height: 1.55;
        letter-spacing: 0.08em;
    }

    .footer_bottom {
        max-width: 1280px;
        margin: 2.2rem auto 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .footer_logo {
        font-family: "Cormorant Garamond", "Shippori Mincho", serif;
        font-size: clamp(1.3rem, 2.5vw, 1.5rem);
        letter-spacing: 0.3em;
    }

    .footer_copy {
        font-family: "Jost", "Shippori Mincho", sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.5);
    }
}

.reveal {
    opacity: 0;
    transform: translateY(56px) scale(0.96);
}
@media (max-width: 1024px) {

    #ring {
        display: none !important;
    }

    .menu_inner {
        justify-content: flex-start;
    }

    .menu_feature {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .menu_card .menu_card_img {
        aspect-ratio: 16 / 7;
    }

    .menu_links {
        grid-template-columns: 1fr;
    }

    .menu_foot {
        grid-template-columns: 1fr;
    }

    .hero {
        grid-template-columns: 1fr;

        .hero_copy {
            padding: 8rem clamp(1.5rem, 5.5vw, 5rem) 2rem;
            order: 2;
        }

        .hero_stage {
            height: 46vh;
            order: 1;
        }

        .hero_vertical,
        .hero_scroll {
            display: none;
        }
    }

    .concept {
        grid-template-columns: 1fr;

        .concept_stage {
            display: none;
        }

        .concept_copy {
            text-align: center;

            .accent_line {
                margin: 0 auto;
            }
        }
    }

    .detail {
        grid-template-columns: 1fr;
        grid-template-rows: none;
        text-align: center;
        gap: 2rem;

        .detail_copy,
        .detail_spec,
        .detail_stage,
        .detail_foot {
            grid-column: 1;
            justify-self: center;
        }

        .detail_stage {
            height: 40vh;
            width: 100%;
        }
    }

    .only_one {
        grid-template-columns: 1fr;

        .only_one_panel {
            min-height: 56vh;
        }

        .only_one_stage {
            inset: auto;
            top: 42%;
            left: 50%;
            width: 34%;
            height: 34%;
            transform: translate(-50%, 0);
        }
    }

    .product_list {

        .product_list_showcase {
            grid-template-columns: 1fr;
        }

        .product_list_ring_mb {
            display: block;
        }

        .product_list_stage[data-ring-slot]::after {
            display: none;
        }

        .product_list_label {
            font-size: 0.62rem;
            padding: 0.45em 0.85em;
            max-width: 42%;
            white-space: normal;
        }

        .product_list_label_price {
            top: 22%;
            left: 4%;
        }

        .product_list_label_maten {
            top: 14%;
            right: 4%;
        }

        .product_list_label_mat {
            bottom: 8%;
            left: 6%;
        }

        .product_list_aside {

            .textlink {
                align-self: flex-start;
            }
        }
    }

    .whyus {

        .whyus_inner {
            grid-template-columns: 1fr;
            gap: clamp(2rem, 5vw, 3rem);
        }

        .whyus_visual {
            aspect-ratio: 16 / 9;
            max-height: 340px;
        }
    }

    .flow {

        .flow_item {
            grid-template-columns: 8rem 1fr;
            row-gap: 0.4rem;
        }

        .flow_desc {
            grid-column: 1 / -1;
        }
    }

    .reviews {

        .reviews_grid {
            grid-template-columns: 1fr;
            max-width: 460px;
            margin: 0 auto;
        }
    }

    .stores {

        .stores_grid {
            grid-template-columns: repeat(2, 1fr);
            row-gap: 2.5rem;
        }
    }
}
@media (max-width: 720px) {

    .collection {

        .collection_row {
            grid-template-columns: 1fr auto;
            grid-template-areas:
                "name arrow"
                "jp arrow"
                "desc arrow";
            gap: 0.3rem 1rem;

            .collection_row_name {
                grid-area: name;
            }

            .collection_row_jp {
                grid-area: jp;
            }

            .collection_row_desc {
                grid-area: desc;
            }

            .collection_row_arrow {
                grid-area: arrow;
                align-self: center;
            }
        }
    }

    .craft {
        background:
            linear-gradient(rgba(20, 22, 27, 0.82), rgba(20, 22, 27, 0.9)),
            url("../img/yaki.png") center / cover no-repeat fixed,
            #14161B;

        .craft_stage {
            display: none;
        }

        .craft_panels {
            top: auto;
            bottom: 7rem;
            left: clamp(1.5rem, 5.5vw, 5rem);
            right: clamp(1.5rem, 5.5vw, 5rem);
            width: auto;
            transform: none;
            text-align: left;
        }

        .craft_panel {
            top: auto;
            bottom: 0;
            transform: none;
            text-align: left;
        }

        .craft_figure {
            display: block;
            width: 100%;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            margin-bottom: 1.4rem;
        }

        .craft_index {
            margin-bottom: 0.8rem;
        }

        .craft_step {
            font-size: clamp(2rem, 9vw, 2.8rem);
            margin-bottom: 1rem;
        }

        .craft_note {
            margin-left: 0;
            margin-right: 0;
            max-width: 100%;
            width: 100%;
            padding: 1.3rem 1.4rem;
            border-color: rgba(195, 168, 120, 0.4);
            background: rgba(195, 168, 120, 0.05);

            p {
                font-size: 0.84rem;
                line-height: 1.95;
            }
        }

        .craft_rail,
        .craft_progress {
            display: none;
        }

        .craft_lockup {
            position: static;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
            padding: 0 clamp(1.5rem, 5.5vw, 5rem);
            margin-bottom: 0.5rem;
        }

        .craft_brand {
            writing-mode: horizontal-tb;
            text-orientation: mixed;
            font-size: clamp(2.6rem, 12vw, 3.4rem);
            letter-spacing: 0.02em;
            line-height: 1;
        }

        .craft_brand_jp {
            writing-mode: horizontal-tb;
            margin-top: 0;
            letter-spacing: 0.42em;
        }
    }

    .contact {

        .field_row {
            grid-template-columns: 1fr;
        }
    }

    .news {

        .news_row {
            grid-template-columns: 1fr auto;
            grid-template-areas:
                "date arrow"
                "tag arrow"
                "text arrow";
            gap: 0.3rem 1rem;

            .news_row_date {
                grid-area: date;
            }

            .news_row_tag {
                grid-area: tag;
                width: 3.4rem;
            }

            .news_row_text {
                grid-area: text;
            }

            .news_row_arrow {
                grid-area: arrow;
                align-self: center;
            }
        }
    }

    .flow {

        .flow_item {
            grid-template-columns: 1fr;
        }
    }

    .stores {

        .stores_grid {
            grid-template-columns: 1fr;
        }
    }

    .footer {

        .footer_top {
            flex-direction: column;
            align-items: flex-start;
        }
    }
}
@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    .reveal {
        opacity: 1;
        transform: none;
    }

    .craft {

        .craft_bg {
            transition: opacity 0.3s ease;
            transform: none;
        }
    }

    .hero {

        .hero_scroll_arrow {
            animation: none;
            transform: rotate(45deg);
        }
    }
}
